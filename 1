#include <stdio.h>
#include <stdlib.h>
#include <signal.h>
#include <unistd.h>

volatile sig_atomic_t sigint_count = 0;

void handle_sigint(int sig) {
    sigint_count++;
}

int main(void) {
    struct sigaction sa;
    sa.sa_handler = handle_sigint;
    sigemptyset(&sa.sa_mask);
    sa.sa_flags = 0;

    if (sigaction(SIGINT, &sa, NULL) < 0) {
        perror("sigaction error");
        exit(1);
    }

    printf("프로그램 실행 중... Ctrl+C를 3번 누르세요.\n");

    int local_count = 0;
    while (1) {
        if (sigint_count != local_count) {
            local_count = sigint_count;
            printf("\n[main] Ctrl+C 입력 횟수: %d\n", local_count);

            if (local_count >= 3) {
                printf("[main] 3번 눌러서 프로그램을 종료합니다.\n");
                break;
            }
        }
        pause();
    }

    return 0;
}
